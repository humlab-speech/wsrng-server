MONGO_USER=root
MONGO_PASSWORD=
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=wsrng

SERVER_PORT=8080
AUDIO_FILE_STORAGE_PATH=audio
ENABLED_MODULES=["visp"]
LOG_PATH=logs/wsrng-server.log

#Service base URLs used by the visp handler module. These lines are
#optional: visp.js falls back to the same defaults shown here, so they
#are only needed when the service names on your network differ.
SESSION_MANAGER_URL=http://session-manager:8080
APACHE_URL=http://apache
